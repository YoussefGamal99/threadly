# Threadly Atelier - Root Environment Variables Example
# Copy to .env (or backend/.env) and populate secrets.

# Groq API Key (required for LangChain stylist agent execution)
GROQ_API_KEY=

# LLM Models Configuration
PRIMARY_MODEL=openai/gpt-oss-120b
FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
SUMMARY_MODEL=openai/gpt-oss-20b
SUMMARY_TRIGGER_TOKENS=6000
SUMMARY_KEEP_MESSAGES=12

# Prompt Guard & Safety
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_THRESHOLD=0.9

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Frontend API Base URL (leave empty to use Vite proxy in local dev)
VITE_API_BASE_URL=
