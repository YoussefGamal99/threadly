# Threadly Atelier - Backend Environment Variables
# Groq API Key (required for stylist agent execution)
GROQ_API_KEY=

# LLM Models Configuration
PRIMARY_MODEL=openai/gpt-oss-120b
FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
SUMMARY_MODEL=openai/gpt-oss-20b
SUMMARY_TRIGGER_TOKENS=6000
SUMMARY_KEEP_MESSAGES=12

# Prompt Guard & Safety
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_THRESHOLD=0.9

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Embedding model & Storage Paths (defaults to backend/data/)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# STORE_DB_PATH=
# MEMORY_DB_PATH=
# CHROMA_DIR=
# PRODUCT_IMG_DIR=
